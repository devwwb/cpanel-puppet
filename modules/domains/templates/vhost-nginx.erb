server {

    root <%= @path -%>;

    server_name  <%= @domain -%>  www.<%= @domain -%>;

    listen 127.0.0.3:443 ssl proxy_protocol;

    http2 on;

    #hsts
    add_header "Strict-Transport-Security" "\"max-age=15552000; includeSubDomains\" always";

    #real ip
    set_real_ip_from 127.0.0.1/32;
    real_ip_header proxy_protocol;

    #log
    access_log            /var/log/nginx/<%= @domain -%>-ssl.access.log;
    error_log             /var/log/nginx/<%= @domain -%>-ssl.error.log;

    # RSA certificate
    ssl_certificate /etc/letsencrypt/live/<%= @domain -%>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<%= @domain -%>/privkey.pem;

    #include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot

    # Redirect non-https traffic to https
    if ($scheme != "https") {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    index index.html index.htm index.php;

    location / {
        # Allow burst of 20 extra requests; nodelay processes them immediately
        limit_req zone=generic burst=20 nodelay;
        # Return 429 Too Many Requests instead of default 503
        limit_req_status 429;
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        # Allow burst of 20 extra requests; nodelay processes them immediately
        limit_req zone=generic burst=20 nodelay;
        # Return 429 Too Many Requests instead of default 503
        limit_req_status 429;

        try_files $uri =404;
        <% if @pool == 'www' %>
        fastcgi_pass 127.0.0.1:9000;
        <% else %>
        fastcgi_pass unix:/run/php/<%= @pool %>-fpm.sock;
        <% end %>
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }

}

